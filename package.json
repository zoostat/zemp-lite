{
  "name": "zemp-lite",
  "version": "0.2.0-dev",
  "description": "Zemp Lite, the code-first workspace for the Zeff statistics language",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.node.json",
    "check:rust": "cd worker && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
    "test:unit": "vitest run",
    "test:rust": "cd worker && cargo test --locked",
    "build:worker": "node worker/build.mjs",
    "test:worker": "node --test worker/js/worker.test.mjs",
    "measure:worker": "node tools/measure-worker.mjs",
    "check:samples": "node tools/check-samples.mjs",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium webkit",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "routine": "npm run check:format && npm run check:lint && npm run check:types && npm run check:rust && npm run test:rust && npm run build:worker && npm run test:worker && npm run measure:worker && npm run check:samples && npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  }
}
