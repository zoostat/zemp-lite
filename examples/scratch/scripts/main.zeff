// Returns to schooling, in the wages panel that ships with Zeff.
// Press Run: each statement's result opens under it, and a note beside it says what it made.

// # Sample
let wages = dataset(wages)
    .where(year >= 2012 && age >= 25)
    .add(lwage = log(wage), exper2 = exper^2)

// # Describe
wages.summary([lwage, educ, exper, hours], by: female)
let shape = wages.plot(x: lwage).histogram(bins: 30)

// # Models
let m1 = wages.reg(lwage ~ educ + exper + exper2, se: robust)
let m2 = wages.reg(lwage ~ educ + exper + exper2 + female + union,
    cluster: worker)
let m3 = wages.reg(lwage ~ educ + exper + exper2 + female + union,
    fe: industry + year, cluster: worker)
report([m1, m2, m3])

// # Figure
let y2019 = wages.where(year == 2019)
let schooling = y2019.scatter(educ, lwage, fit: linear)
